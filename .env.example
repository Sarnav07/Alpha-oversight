AIML_API_KEY=
AIML_API_KEY_2=                               # second AIML account (prosecution-frontier / escalation-frontier)
AIML_API_BASE=https://api.aimlapi.com/v1
AIML_FRONTIER_MODEL=                          # set later from live catalog; litellm "aiml/<id>". DO NOT hardcode unverified.
AIML_FRONTIER_MODEL_ALT=
AIML_FREE_MODEL=
ADVERSARY_MODEL=                              # R&D adversary (paid seat). Anthropic frontier, e.g. claude-opus-4-8. Keep a family != the open seats.
FEATHERLESS_AI_API_KEY=
FEATHERLESS_AI_API_KEY_2=                     # second Featherless account (prosecution + defense)
FEATHERLESS_AI_API_KEY_3=                     # third Featherless account (adjudicator + escalation)
FEATHERLESS_OPEN_MODEL=                        # litellm "featherless_ai/Org/Model" — anomaly + investigator + specialist (triage)
FEATHERLESS_PROSECUTION_MODEL=                 # prosecution (debate); each below falls back to FEATHERLESS_OPEN_MODEL if blank
FEATHERLESS_DEFENSE_MODEL=                     # defense (debate)
FEATHERLESS_ADJUDICATOR_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct  # adjudicator (window resolve) — fast MoE (~5s); replaces GLM-5.2 to avoid its multi-minute cold-load stall
FEATHERLESS_ESCALATION_MODEL=                  # escalation (human packet)
FEATHERLESS_MAX_CONCURRENCY=4
BAND_RND_API_KEY=
BAND_RND_AGENT_ID=
BAND_RND_ROOM=
BAND_SURV_API_KEY=
BAND_SURV_AGENT_ID=
BAND_SURV_ROOM=
BAND_SHARED_ROOM=                             # the one room both desks + human share (defaults to BAND_RND_ROOM if blank)
BAND_API_BASE=https://app.band.ai/api/v1
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_HUMAN_PEER=
USE_REAL_BAND=false                           # false → MockBand (default this round)
LEDGER_DIR=./data/ledger
EVENTS_DIR=./data/events
CASE_DB=./data/cases.db
RULES_DB=./data/rules.db
MEMORY_DB=./data/memory.db
BACKEND_PORT=8000
FRONTEND_API_BASE=http://localhost:8000
LLM_CALL_TIMEOUT=900                          # per-call ceiling in seconds (default 600; 900 clears worst cold-load)
