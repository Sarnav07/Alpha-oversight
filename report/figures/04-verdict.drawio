<mxfile host="alpha-oversight" type="device">
  <diagram name="verdict" id="verdict-1">
    <mxGraphModel dx="1300" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1140" pageHeight="430" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- inputs -->
        <mxCell id="in1" value="Order events" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2BD;strokeWidth=1.25;fontSize=11;fontColor=#14161C;" vertex="1" parent="1">
          <mxGeometry x="40" y="84" width="200" height="48" as="geometry" />
        </mxCell>
        <mxCell id="in2" value="Resolved inputs&#10;window_ms · bona-fide ids · intent&#10;— the only values the LLM debate sets" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF1F6;strokeColor=#6B76A0;strokeWidth=1.25;fontSize=11;fontColor=#14161C;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="in3" value="Active rules (registry)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB2BD;strokeWidth=1.25;fontSize=11;fontColor=#14161C;" vertex="1" parent="1">
          <mxGeometry x="40" y="268" width="200" height="48" as="geometry" />
        </mxCell>

        <!-- process -->
        <mxCell id="proc" value="For each active rule, in order:&#10;run the family metric&#10;spoofing · layering · wash · marking&#10;overlay the resolved window&#10;— first rule that trips wins —" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBFBFC;strokeColor=#6B7280;strokeWidth=1.5;fontSize=11;fontColor=#14161C;" vertex="1" parent="1">
          <mxGeometry x="324" y="138" width="262" height="124" as="geometry" />
        </mxCell>

        <!-- decision -->
        <mxCell id="dec" value="any rule&#10;trips?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#14161C;strokeColor=#C9A227;strokeWidth=2.5;fontSize=12;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="664" y="152" width="170" height="96" as="geometry" />
        </mxCell>

        <!-- outcomes -->
        <mxCell id="flag" value="FLAG&#10;rule_id + cited metric" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EF4444;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#B42318;" vertex="1" parent="1">
          <mxGeometry x="912" y="92" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="pass" value="PASS&#10;no rule fired" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E9F8F1;strokeColor=#0E9E6E;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#0B7A55;" vertex="1" parent="1">
          <mxGeometry x="912" y="244" width="190" height="64" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#AAB2BD;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="in1" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6B76A0;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="in2" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#AAB2BD;strokeWidth=1.25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="in3" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6B7280;strokeWidth=1.5;" edge="1" parent="1" source="proc" target="dec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="yes" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#EF4444;strokeWidth=1.5;fontSize=11;fontColor=#B42318;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="flag"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="no" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0E9E6E;strokeWidth=1.5;fontSize=11;fontColor=#0B7A55;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="pass"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- footer -->
        <mxCell id="foot" value="The models only set the contested inputs. The rule engine renders PASS / FLAG deterministically — same inputs, same answer, every time. No LLM overrules it." style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#3A3A3A;" vertex="1" parent="1">
          <mxGeometry x="40" y="356" width="1060" height="22" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
