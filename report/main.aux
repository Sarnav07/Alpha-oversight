\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Co-evolution. A confirmed novel evasion becomes a regression-tested rule in one step; the active count goes from four to five and the case flips PASS to FLAGGED.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:coevo}{{5}{4}{Co-evolution. A confirmed novel evasion becomes a regression-tested rule in one step; the active count goes from four to five and the case flips PASS to FLAGGED}{figure.caption.5}{}}
