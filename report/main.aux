\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The trust layer. Left: the wall strips reasoning and model identity, so only the bare order crosses. Right: the hash chain binds every Band message and breaks visibly on any tamper.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:trust}{{6}{4}{The trust layer. Left: the wall strips reasoning and model identity, so only the bare order crosses. Right: the hash chain binds every Band message and breaks visibly on any tamper}{figure.caption.6}{}}
