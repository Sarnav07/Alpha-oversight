\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Following one case, end to end}{2}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One case, end to end. Band hops are blue; the Prosecution--Defense debate runs locally, off Band. The engine returns a FLAG citing the rule and the metric that tripped.}}{2}{figure.caption.2}\protected@file@percent }
